{
  "name": "UploadJob",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "size_bytes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "completed"
    },
    "error": {
      "type": "string"
    },
    "connection_id": {
      "type": "string"
    }
  },
  "required": [
    "file_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}