{
  "name": "ShareLink",
  "type": "object",
  "properties": {
    "file_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "download_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "file_id",
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}