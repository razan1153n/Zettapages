{
  "name": "UserQuota",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "quota_bytes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deletion_requested",
        "deleted"
      ],
      "default": "active"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "notify_uploads": {
      "type": "boolean",
      "default": true
    },
    "notify_security": {
      "type": "boolean",
      "default": true
    },
    "notify_storage": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}