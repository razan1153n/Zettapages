{
  "name": "FileAccessToken",
  "type": "object",
  "properties": {
    "file_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "preview",
        "download"
      ],
      "default": "preview"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "file_id",
    "token"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}